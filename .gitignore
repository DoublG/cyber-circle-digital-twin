# Everything generated goes to out/ (movies, render frames, exports, release builds)
out/
dist/

# Godot
.godot/
*.import.tmp
game/tests/shots/
game/tests/_recovery*.db*
game/tests/_recovery_godot.log
game/tests/_recovery_broker.log
game/tests/_voice/
game/tests/_e2e_events/

# Python
**/.venv/
__pycache__/

# runtime data: databases, logs
*.db
*.db-shm
*.db-wal
*.log

# blender backups
*.blend1

# PlatformIO build output, flash logs
firmware/*/.pio/
firmware/robot/robot_flash_*.txt

# control: the local https certificate (tools/ops/make_cert.sh)
control/*.pem

# deploy: the generated certificates (deploy/certs/make_certs.sh)
deploy/certs/*.pem
deploy/certs/*.key
deploy/certs/*.srl
deploy/certs/server.san

# read-aloud generator (tools/assets/voice/setup.sh): the downloaded model,
# the reference voice (a person's voice: not in git)
tools/assets/voice/models/
tools/assets/voice/reference*.wav
