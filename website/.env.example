# The website's settings (copy to .env; never commit .env)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=cyberchallenge.coderdojobelgium.be
DJANGO_CSRF_TRUSTED_ORIGINS=https://cyberchallenge.coderdojobelgium.be
# default: SQLite (in Docker: /data/site.db); PostgreSQL: postgres://user:password@host:5432/cyberchallenge
# DATABASE_URL=
# the installation's control server uses the same secret (--website-token / CC_WEBSITE_TOKEN)
SYNC_TOKEN=change-me-too
